#!/bin/bash

bat=$(grep -rl '^Battery$' /sys/class/power_supply/*/type 2>/dev/null | head -1 | xargs dirname)

if [ -z "$bat" ]; then
    exit 0
fi

if [ -f "$bat/capacity" ]; then
    cap=$(cat "$bat/capacity")
else
    now=$(cat "$bat/energy_now")
    full=$(cat "$bat/energy_full")
    cap=$(( now * 100 / full ))
fi

status=$(cat "$bat/status" 2>/dev/null)

case "$status" in
    Charging)     suffix=" ↑" ;;
    Discharging)  suffix=" ↓" ;;
    "Not charging") suffix=" =" ;;
    Full)         suffix=" =" ;;
    *)            suffix="" ;;
esac

# Warn once per discharge, not once per poll: this block runs every 30s, and
# the old unconditional notify-send meant a low battery produced a warning
# every half minute for as long as it took to find the charger.
threshold=$(dotstyle get battery.warn_below 2>/dev/null || echo 15)
warned="${XDG_RUNTIME_DIR:-/tmp}/dotstyle/battery-warned"

if [ "$status" = "Discharging" ] && [ "$cap" -le "$threshold" ]; then
    if [ ! -f "$warned" ]; then
        mkdir -p "$(dirname "$warned")"
        touch "$warned"
        dot-notify -u critical -t 30000 -s battery "󱐋" "Time to recharge" "Battery is down to ${cap}%"
    fi
elif [ "$cap" -gt "$threshold" ]; then
    rm -f "$warned"
fi

echo "bat ${cap}%${suffix}"
