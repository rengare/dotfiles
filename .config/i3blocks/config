[dnd]
command=dotstyle toggle dnd --i3blocks; if [ "$BLOCK_BUTTON" = "1" ]; then dotstyle toggle dnd >/dev/null; fi
interval=5

[stay-awake]
command=dotstyle toggle stay-awake --i3blocks; if [ "$BLOCK_BUTTON" = "1" ]; then dotstyle toggle stay-awake >/dev/null; fi
interval=5

[nightlight]
command=dotstyle toggle nightlight --i3blocks; if [ "$BLOCK_BUTTON" = "1" ]; then dotstyle toggle nightlight >/dev/null; fi
interval=5

[network]
command=echo "network"; if [ "$BLOCK_BUTTON" = "1" ]; then { [ -n "$WAYLAND_DISPLAY" ] && setsid foot -e wlctl || { . ~/.profile; setsid $TERMINAL -e wlctl; }; }; fi
interval=once

[bluetooth]
command=echo "bluetooth"; if [ "$BLOCK_BUTTON" = "1" ]; then { [ -n "$WAYLAND_DISPLAY" ] && setsid foot -e bluetui || { . ~/.profile; setsid $TERMINAL -e bluetui; }; }; fi
interval=once

[audio]
command=~/.config/i3blocks/audio; if [ "$BLOCK_BUTTON" = "1" ]; then { [ -n "$WAYLAND_DISPLAY" ] && setsid foot -e wiremix -v output || { . ~/.profile; setsid $TERMINAL -e wiremix -v output; }; }; fi
interval=10

[temp]
command=sensors | awk '/^cpu[0-9].*top.*thermal/{found=1} found && /temp1/{sum+=$2; count++; found=0} END{printf "cpu %.0f°C\n", sum/count}'
interval=10

[weather]
command=curl -sf "wttr.in/Wroclaw?format=1" 2>/dev/null || echo "N/A"
interval=1800

[battery]
command=~/.config/i3blocks/battery
interval=30

[time]
command=date '+%a %d %b  %H:%M'
interval=10

[powermenu]
command=echo "⏻"; if [ "$BLOCK_BUTTON" = "1" ]; then setsid dot-menu & fi
interval=once
