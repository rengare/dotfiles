
configuration {
  fullscreen: false;

  /* `dot` is a script mode: dot-run lists every dot-* action and runs the one
     picked. It is combined with drun so $mod+d shows applications and session
     actions in one list — drun alone only ever sees .desktop files, and the
     alternative would be generating thirty-odd of those into
     ~/.local/share/applications, cluttering every other launcher too. */
  /* `kill` is a second script mode: dot-kill lists open windows and the
     programs running behind them, and ends the one picked. Deliberately not in
     combi-modi — the launcher would drown in processes. It is reached by
     mode-switch from the same $mod+d, so nothing is rebound. */
  modi: "drun,run,window,dot:dot-run,kill:dot-kill";
  combi-modi: "drun,dot";
  combi-display-format: "{mode} {text}";
  icon-theme: "";
  show-icons: false;
  drun-display-format: "{icon} {name}";
  location: 0;
  disable-history: true;
  hide-scrollbar: true;
  display-drun: " Apps ";
  display-run: "  Run ";
  display-window: "  Window";
  display-dot: "󰅱 Dot";
  display-kill: "󰅚 Kill";
  display-combi: " Launch ";
  display-Network: "  Network";
  sidebar-mode: true;
  terminal: "kitty";

  kb-row-up: "Up,Control+k,Shift+Tab,Shift+ISO_Left_Tab";
  kb-row-down: "Down,Control+j";
  kb-accept-entry: "Control+m,Return,KP_Enter";
  kb-remove-to-eol: "Control+Shift+e";
  /*kb-mode-next: "Shift+Right,Control+Tab,Control+l";*/
  kb-mode-previous: "Shift+Left,Control+Shift+Tab,Control+h";
  /* The force-kill key in 󰅚 Kill mode, which reaches dot-kill as ROFI_RETV=10.
     Comma-separated so rofi's own Alt+1 default keeps working — this adds a
     binding, it does not replace one. */
  kb-custom-1: "Alt+1,Alt+k";
  kb-remove-char-back: "BackSpace";
}

/* Palette and font are generated by dotstyle. */
@import "/home/ren/workspace/dotfiles/theme/current/rofi.rasi"

