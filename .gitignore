# Rust build output for the dotstyle TUI.
tui/target/

# Wallpapers live outside the repo entirely now — one shared pool, by default
# ~/Pictures/wallpapers, set by `dir` under [wallpaper] in theme/settings.toml.
# This pattern stays only so an old checkout with per-theme artwork does not
# suddenly want to commit ~53 MB of it.
theme/themes/*/backgrounds/

# The wallpaper symlink is machine-local; theme/settings.toml records the choice.
theme/current/background
.config/cosmic/com.vintagetechie.CosmicExtAppletTempest

# fish rewrites its universal variables itself, differently per machine
.config/fish/fish_variables

# Generated by Noctalia (user template)
.config/foot/themes/noctalia
.config/ghostty/themes/noctalia
.config/kitty/themes/noctalia.conf

# Per-machine flameshot overrides (see bin/dot-flameshot-config)
.config/flameshot/flameshot.local.ini
.config/fish/conf.d/cosmic-outputs.fish
