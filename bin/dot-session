#!/usr/bin/env bash
# Start or restart the sway session daemons.
#
# Called from the generated sway include via `exec_always`, which re-runs on
# every reload — and dotstyle reloads sway on every theme change. So every
# daemon here is stopped before it is started; without that, a swayidle would
# accumulate per theme switch.
#
# Daemons are tracked by pidfile rather than matched with `pkill -f`. A pattern
# like 'wl-paste --watch cliphist' matches any command line merely *containing*
# those words — including the shell that is running this script from a prompt —
# so pattern-killing can take out something it was never meant to touch.
#
# Each daemon is optional: a missing binary is reported, never fatal, so a
# fresh machine without the full package set still gets a working session.

set -uo pipefail

RUNTIME="${XDG_RUNTIME_DIR:-/tmp}/dotstyle"
mkdir -p "$RUNTIME"

action="${1:-restart}"

# Daemons stopped and started again on every reload. Cheap to restart and
# stateless, so a reload is the simplest way to pick up new settings.
RESTARTED=(idle clipboard resume)

# Started once and then left alone.
#
# Every terminal on the desktop is a client of the foot server: killing it
# closes all of them at once, which is a spectacular thing to do in response
# to a theme change. Worse, it does not even leave a working server behind —
# `foot --server` refuses to bind while the outgoing one is still shutting
# down ("socket is already accepting connections"), so a stop-then-start can
# land on no server at all and `$mod+t` quietly stops working.
PERSISTENT=(foot-server)

# Every daemon managed here, in start order.
DAEMONS=("${RESTARTED[@]}" "${PERSISTENT[@]}")

pidfile() { echo "$RUNTIME/$1.pid"; }

running() {
  local pid
  pid=$(cat "$(pidfile "$1")" 2>/dev/null) || return 1
  [[ -n $pid ]] && kill -0 "$pid" 2>/dev/null
}

stop_one() {
  local name=$1 pid
  pid=$(cat "$(pidfile "$1")" 2>/dev/null) || return 0
  if [[ -n $pid ]]; then
    if [[ $name == resume ]]; then
      kill -- "-$pid" 2>/dev/null
    else
      kill "$pid" 2>/dev/null
    fi
  fi
  rm -f "$(pidfile "$1")"
  return 0
}

# Start a daemon detached, recording its real PID.
#
# `setsid cmd & ; echo $!` does not do that. setsid forks whenever the caller
# is a process group leader, so `$!` is setsid's PID and setsid exits the
# moment it has forked — leaving a pidfile that points at a process which is
# already gone. Everything downstream then lies: `status` reports a running
# daemon as stopped, and `stop` signals a dead PID and leaves the daemon
# running, so a reload accumulates a second copy.
#
# The daemon writes its own PID instead. `$$` is read after setsid has done
# whatever forking it intends to do and before `exec` replaces the shell, so
# it is the PID the daemon itself will have, whether setsid forked or not.
spawn() {
  local name=$1
  shift
  setsid bash -c 'echo $$ >"$1"; shift; exec "$@"' _ "$(pidfile "$name")" "$@" \
    >/dev/null 2>&1 &
}

stop_many() {
  local name
  for name in "$@"; do
    stop_one "$name"
  done
}

stop() {
  stop_many "${DAEMONS[@]}"
  # A swayidle from before pidfiles existed, or from a crashed session, would
  # otherwise linger. -x matches the executable name exactly, so this is safe
  # in a way that -f would not be.
  pkill -x swayidle 2>/dev/null
  return 0
}

start_idle() {
  command -v swayidle >/dev/null || { echo "dot-session: swayidle not installed"; return; }

  # One argument per line, so nothing here has to survive shell quoting.
  # Empty output means the timeline is off, or stay-awake is set.
  local args=()
  mapfile -t args < <(dotstyle idle args 2>/dev/null)
  ((${#args[@]})) || { echo "dot-session: idle timeline disabled"; return; }

  spawn idle swayidle "${args[@]}"
}

start_clipboard() {
  command -v cliphist >/dev/null || { echo "dot-session: cliphist not installed"; return; }
  spawn clipboard wl-paste --watch cliphist store
}

# The terminal server behind `$mod+t`. See PERSISTENT above for why this one
# is started rather than restarted.
start_foot_server() {
  command -v foot >/dev/null || { echo "dot-session: foot not installed"; return; }
  running foot-server && return
  spawn foot-server foot --server
}

start_resume() {
  command -v dbus-monitor >/dev/null || { echo "dot-session: dbus-monitor not installed"; return; }
  spawn resume bash "$(dirname "$(readlink -f "$0")")/dot-resume"
}

# Is a swaybg actually showing a picture?
#
# `pgrep -x swaybg` is not that question, and answering the wrong one is what
# left a cold boot with no wallpaper. sway spawns a swaybg of its own — see
# `spawn_swaybg()` — on startup and again on every reload, and when no output
# has a `bg` configured it spawns it with *no arguments at all*. That process
# reaches an empty config list, so it never creates a layer surface and never
# draws anything, but it sits there sleeping under the name swaybg for the
# life of the session. A bare pgrep sees it, concludes the background is
# handled, and skips the one call that would have drawn it.
#
# The picture is in the arguments, so that is where to look: an image swaybg
# carries `-i`, and sway's carries nothing.
wallpaper_showing() {
  local pid
  for pid in $(pgrep -x swaybg 2>/dev/null); do
    if tr '\0' '\n' <"/proc/$pid/cmdline" 2>/dev/null | grep -qx -e -i -e --image; then
      return 0
    fi
  done
  return 1
}

# The wallpaper is deliberately *not* a tracked daemon.
#
# `dotstyle apply` already restarts swaybg whenever the wallpaper changes, so
# stopping and starting it here on every reload would only flicker the desktop
# for no gain. What was missing is the login case: sway starting fresh, with
# nothing having drawn a background yet.
start_wallpaper() {
  command -v swaybg >/dev/null || { echo "dot-session: swaybg not installed"; return; }
  wallpaper_showing && return
  dotstyle wallpaper apply >/dev/null 2>&1 \
    || echo "dot-session: could not apply the wallpaper"
}

# Warm the display back up if the nightlight toggle says it was on.
#
# gammastep holds the gamma ramp through the wlr-gamma-control protocol, which
# the compositor drops the moment the client disconnects — so nightlight does
# not survive a logout the way the marker file under ~/.local/state does. Then
# the marker says warm, the screen is cold, and the bar indicator is lying.
#
# `reassert` re-fires the side effect for whatever the state already says
# without flipping it, and that side effect leaves a healthy gammastep alone,
# so this costs nothing on the reloads where it has nothing to do.
start_nightlight() {
  dotstyle toggle nightlight reassert >/dev/null 2>&1 \
    || echo "dot-session: could not re-assert the nightlight"
}

case "$action" in
  restart|start)
    stop_many "${RESTARTED[@]}"
    start_idle
    start_clipboard
    start_foot_server
    start_resume
    start_wallpaper
    start_nightlight
    ;;
  stop)
    stop
    ;;
  status)
    for name in "${DAEMONS[@]}"; do
      if running "$name"; then
        printf '%-10s running (pid %s)\n' "$name" "$(cat "$(pidfile "$name")")"
      else
        printf '%-10s stopped\n' "$name"
      fi
    done
    if wallpaper_showing; then
      printf '%-10s running\n' wallpaper
    else
      printf '%-10s stopped\n' wallpaper
    fi
    if pgrep -x gammastep >/dev/null; then
      printf '%-10s running (pid %s)\n' nightlight "$(pgrep -x gammastep | head -1)"
    else
      printf '%-10s off\n' nightlight
    fi
    ;;
  *)
    echo "usage: dot-session [restart|start|stop|status]" >&2
    exit 1
    ;;
esac
