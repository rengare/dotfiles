#!/usr/bin/env bash
# Window and session appearance toggles, over the compositor's IPC.
#
# sway and Hyprland both go through bin/lib/dot-wm.sh's wm_kind() branch.
# Bar-hide has no sway/Hyprland primitive in common — sway toggles swaybar's
# mode, Hyprland has no bar of its own (waybar is a separate process) — so
# under Hyprland this toggles waybar itself, the same way the old Hyprland
# keybinding used to (`pkill waybar || waybar`).

set -uo pipefail
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/lib/dot-wm.sh"

STATE="${XDG_RUNTIME_DIR:-/tmp}/dotstyle"
mkdir -p "$STATE"

focused_opacity() {
  case "$(wm_kind)" in
    hyprland)
      # Hyprland has no query for a window's current alpha, so the last value
      # this script set is tracked per window address instead. Untracked
      # (never cycled) reads as fully opaque, same as sway's default.
      local id statefile
      id=$(hyprctl -j activewindow 2>/dev/null | jq -r '.address // empty')
      [[ -n $id ]] || { echo 1; return; }
      statefile="$STATE/opacity-${id#0x}"
      cat "$statefile" 2>/dev/null || echo 1
      ;;
    *)
      swaymsg -t get_tree | jq -r 'recurse(.nodes[]?, .floating_nodes[]?)
        | select(.focused == true) | .opacity // 1' | head -n1
      ;;
  esac
}

case "${1:-}" in
  bar)
    case "$(wm_kind)" in
      hyprland)
        if pkill -x waybar 2>/dev/null; then
          dot-notify -s bar "󰍹" "Bar hidden"
        else
          setsid waybar >/dev/null 2>&1 &
          dot-notify -s bar "󰍹" "Bar shown"
        fi
        ;;
      *)
        if [[ -f $STATE/bar-hidden ]]; then
          swaymsg bar mode dock >/dev/null && rm -f "$STATE/bar-hidden"
          dot-notify -s bar "󰍹" "Bar shown"
        else
          swaymsg bar mode invisible >/dev/null && touch "$STATE/bar-hidden"
          dot-notify -s bar "󰍹" "Bar hidden"
        fi
        ;;
    esac
    ;;

  opacity)
    current=$(focused_opacity)
    next=$(awk -v o="$current" 'BEGIN {
      if (o > 0.95) print 0.9;
      else if (o > 0.85) print 0.8;
      else print 1.0
    }')
    case "$(wm_kind)" in
      hyprland)
        id=$(hyprctl -j activewindow 2>/dev/null | jq -r '.address // empty')
        if [[ -n $id ]]; then
          hyprctl dispatch setprop "address:$id" alpha "$next" lock >/dev/null 2>&1
          echo "$next" >"$STATE/opacity-${id#0x}"
        fi
        ;;
      *)
        swaymsg opacity "$next" >/dev/null
        ;;
    esac
    dot-notify -s opacity "󰋩" "Opacity" "$next"
    ;;

  gaps)
    if [[ -f $STATE/gaps-off ]]; then
      restored=$(dotstyle get look.gaps 2>/dev/null || echo 16)
      case "$(wm_kind)" in
        hyprland) hyprctl keyword general:gaps_in "$restored" >/dev/null 2>&1 ;;
        *)        swaymsg gaps inner all set "$restored" >/dev/null ;;
      esac
      rm -f "$STATE/gaps-off"
      dot-notify -s gaps "󰃟" "Gaps restored"
    else
      case "$(wm_kind)" in
        hyprland) hyprctl keyword general:gaps_in 0 >/dev/null 2>&1 ;;
        *)        swaymsg gaps inner all set 0 >/dev/null ;;
      esac
      touch "$STATE/gaps-off"
      dot-notify -s gaps "󰃟" "Gaps off"
    fi
    ;;

  *)
    echo "usage: dot-window [bar|opacity|gaps]" >&2
    exit 1
    ;;
esac
