/* Generated by dotstyle from theme/templates/rofi.rasi.tpl — do not edit.
 * Imported from .config/rofi/config.rasi. Keeps the same variable names the
 * hand-written gruvbox palette used, so the rest of config.rasi is unchanged. */

* {
    highlight: bold italic;
    scrollbar: true;

    font: "JetBrainsMono Nerd Font 12";

    background:                  #121212;
    background-color:            @background;
    foreground:                  #bebebe;
    border-color:                #333333;
    separatorcolor:              @border-color;
    scrollbar-handle:            @border-color;

    normal-background:           @background;
    normal-foreground:           @foreground;
    alternate-normal-background: #1e1e1e;
    alternate-normal-foreground: @foreground;
    selected-normal-background:  #e68e0d;
    selected-normal-foreground:  #121212;

    active-background:           #b91c1c;
    active-foreground:           #121212;
    alternate-active-background: @active-background;
    alternate-active-foreground: @active-foreground;
    selected-active-background:  #b90a0a;
    selected-active-foreground:  @active-foreground;

    urgent-background:           #D35F5F;
    urgent-foreground:           #121212;
    alternate-urgent-background: @urgent-background;
    alternate-urgent-foreground: @urgent-foreground;
    selected-urgent-background:  #B91C1C;
    selected-urgent-foreground:  @urgent-foreground;
}
